rules_version = '2';

// Wallora AI keeps every read and write behind the FastAPI backend, which uses
// the Admin SDK (Admin SDK access is not subject to these rules). Clients must
// never touch Firestore directly: credits, entitlements and jobs would otherwise
// be forgeable from a modified app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
