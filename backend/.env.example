# Wallora AI backend — example environment.
# Copy to backend/.env for local development. Placeholders only: NEVER commit real values.
# Production secrets live in the hosting provider's secret manager.

# --- App ---
APP_ENV=local                         # local | test | staging | prod
APP_DEBUG=false
APP_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Firebase (Auth + Cloud Firestore database) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIRESTORE_PROJECT_ID=                 # optional; defaults to FIREBASE_PROJECT_ID
FIRESTORE_DATABASE=(default)
# Local development against the emulator (firebase emulators:start --only firestore
# --project demo-wallora). Must be unset in staging/prod; the app refuses to start otherwise.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# Path to the service-account JSON, stored OUTSIDE the repository (not needed for the emulator).
GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repo/firebase-service-account.json
APP_CHECK_ENFORCE=false

# --- Cache (optional until Redis-backed rate limiting lands) ---
REDIS_URL=redis://localhost:6379/0

# --- Storage (S3-compatible: local MinIO or Cloudflare R2) ---
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=CHANGE_ME
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME
STORAGE_BUCKET_PRIVATE=wallora-user-private
STORAGE_BUCKET_PUBLIC=wallora-catalog-public
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/wallora-catalog-public
SIGNED_URL_TTL_SECONDS=600

# --- AI provider (fake by default; openai requires explicit owner approval) ---
IMAGE_PROVIDER=fake                   # fake | openai
MODERATION_PROVIDER=fake              # fake | openai
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENAI_TIMEOUT_SECONDS=120

# --- Cost controls (bootstrap defaults; runtime values live in app_settings) ---
GLOBAL_DAILY_COST_CAP_USD=5
GLOBAL_MONTHLY_COST_CAP_USD=50
WORKER_MAX_CONCURRENCY=4

# --- RevenueCat ---
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH_SECRET=
REVENUECAT_PROJECT_ID=

# --- AdMob server-side verification ---
ADMOB_SSV_KEYS_URL=https://www.gstatic.com/admob/reward/verifier-keys.json
ADMOB_REWARDED_AD_UNIT_IDS=

# --- Observability ---
SENTRY_DSN=
METRICS_ENABLED=true
